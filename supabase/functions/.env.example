# Edge Function local configuration only. Production uses Supabase secrets.
# The deployed runtime supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional direct invocation credential (at least 32 random characters).
# The managed cron scheduler authenticates using its separate Vault credential.
NOTIFICATION_WORKER_SECRET=
CLEANUP_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
# Temporary legacy compatibility only. Does not make old public proofs private.
ALLOW_LEGACY_PUBLIC_PROOFS=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=astraeacollection.vercel.app
