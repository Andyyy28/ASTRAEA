{
  "name": "astrea-proj",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:security": "node --test tests/security/*.test.js",
    "check:secrets": "node scripts/scanSecrets.js",
    "test:ci": "npm run lint && npm run check:secrets && npm run test:security && npm run build",
    "cleanup:catalog-images": "node --env-file=.env scripts/cleanupCatalogImages.js",
    "migrate:payment-proofs": "node --env-file=.env scripts/migratePaymentProofs.js",
    "preview": "vite preview",
    "create-admin": "node --env-file=.env createAdmin.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.2"
  }
}
